# =============================================================================
# AZURE AI & SEARCH CONFIGURATION
# =============================================================================
PROJECT_ENDPOINT=https://your-resource-name.services.ai.azure.com/api/projects/your-project-name
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_GPT_DEPLOYMENT=your-gpt-deployment-name
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_INDEX_NAME=your-search-index-name

# =============================================================================
# AZURE STORAGE CONFIGURATION
# =============================================================================
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account-name
AZURE_STORAGE_RAW_CONTAINER_NAME=raw
AZURE_STORAGE_PROCESSED_CONTAINER_NAME=processed
AZURE_STORAGE_SEARCHSTORE_CONTAINER_NAME=searchstore
AZURE_CREDENTIAL_TYPE=CONNECTION_STRING
MI_CLIENT_ID=your-managed-identity-client-id

# =============================================================================
# MULTI-WEBSITE CONFIGURATION (JSON Format - Required)
# =============================================================================
# Configure multiple websites for scraping in JSON array format
# Each website should have: key, url, name, max_depth, folder_name, filters
WEBSITES_CONFIG=[{"key":"httpbin","url":"https://httpbin.org/html","name":"HTTPBin Test","max_depth":1,"folder_name":"httpbin-test","filters":[]},{"key":"sec","url":"https://www.ecb.europa.eu/home/html/index.en.html","name":"SEC Rules","max_depth":2,"folder_name":"sec-rules","filters":[]},{"key":"cbuae","url":"https://rulebook.centralbank.ae/en/rulebook/banking","name":"Central Bank UAE","max_depth":3,"folder_name":"cbuae-banking","filters":["insurance"]}]

# =============================================================================
# PROCESSING CONFIGURATION
# =============================================================================
DEFAULT_WEBSITE_KEY=httpbin
SCRAPING_MODE=full
UPLOAD_TO_CLOUD=true
FLATTEN_DATA=true

# =============================================================================
# AZURE FUNCTIONS CONFIGURATION
# =============================================================================
FUNCTIONS_AUTH_LEVEL=FUNCTION
DEFAULT_MAX_FILES=100
PAYLOAD_SIZE_LIMIT_KB=15

# =============================================================================
# HEALTH CHECK CONFIGURATION
# =============================================================================
HEALTH_CHECK_HOST=0.0.0.0
HEALTH_CHECK_PORT=8000
SERVICE_NAME=web-scraper

# =============================================================================
# REQUEST CONFIGURATION
# =============================================================================
REQUEST_TIMEOUT=10
MAX_RETRIES=3
BACKOFF_FACTOR=2
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# =============================================================================
# LOGGING & TIMER CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
TIMER_ENABLED=false

# =============================================================================
# LOCAL DEVELOPMENT (for Azurite)
# =============================================================================
# For local development, use these Azurite connection settings:
# AZURE_STORAGE_ACCOUNT_NAME=devstoreaccount1
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;QueueEndpoint=http://127.0.0.1:10001/devstoreaccount1;TableEndpoint=http://127.0.0.1:10002/devstoreaccount1;