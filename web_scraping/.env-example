# =============================================================================
# AZURE AI & COGNITIVE SERVICES
# =============================================================================
PROJECT_ENDPOINT=https://your-resource-name.services.ai.azure.com/api/projects/your-project-name
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_GPT_DEPLOYMENT=your-gpt-deployment-name
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_INDEX_NAME=your-search-index-name

# =============================================================================
# SQL DATABASE CONFIGURATION
# =============================================================================
SQL_SERVER_NAME=your-sql-server.database.windows.net
SQL_DATABASE_NAME=your-database-name
SQL_USERNAME=your-sql-username
SQL_PASSWORD=your-sql-password-here

# =============================================================================
# AZURE STORAGE CONFIGURATION
# =============================================================================
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account-name
AZURE_STORAGE_CONTAINER_NAME=your-container-name
AZURE_CREDENTIAL_TYPE=AAD
MI_CLIENT_ID=your-managed-identity-client-id

# =============================================================================
# WEB SCRAPING CONFIGURATION
# =============================================================================
SCRAPING_MAX_DEPTH=3                      # How deep to crawl (1-5 recommended)
SCRAPING_FILTERS=insurance                 # Keywords to filter content
SCRAPING_WEBSITE=cbuae                     # Target website identifier
SCRAPING_MAX_FILES=500                     # Maximum files to download per run

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
LOG_LEVEL=INFO                            # INFO, DEBUG, WARNING, ERROR
TIMER_ENABLED=false                       # Enable/disable scheduled runs

# =============================================================================
# DEVELOPMENT NOTES
# =============================================================================
# 1. Replace all 'your-*' placeholders with actual values
# 2. Never commit this file with real credentials to version control
# 3. For production, use Azure Key Vault or managed identity when possible
# 4. Keep this file in your .gitignore
